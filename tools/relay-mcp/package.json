{
  "name": "grepbot-relay-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP wrapper around GrepBot's local WebSocket relay (ws://127.0.0.1:8731). Local-only, respects the bot's own gates.",
  "type": "module",
  "main": "dist/index.js",
