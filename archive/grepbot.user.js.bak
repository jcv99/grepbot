// ==UserScript==
// @name         GrepBot
// @namespace    grepbot
// @version      0.4.4
// @description  Auto-grab scout reports + farm list notes for es.grepolis.com. ToS forbid automation; risk = ban.
// @author       j
// @match        https://es.grepolis.com/*
// @match        https://es146.grepolis.com/*
// @run-at       document-idle
// @grant        GM_xmlhttpRequest
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_addStyle
// @grant        GM_registerMenuCommand
// @connect      es.grepolis.com
// @connect      es146.grepolis.com
// @connect      127.0.0.1
// @updateURL    http://127.0.0.1:35657/grepbot.user.js
// @downloadURL  http://127.0.0.1:35657/grepbot.user.js
// ==/UserScript==

/* global $, unsafeWindow */

(function () {
  'use strict';

  const STORE = {
    FINDINGS: 'grepbot:findings',
    FARMS:    'grepbot:farms',
    FARMS_PARSED: 'grepbot:farms-parsed',
    FARM_RES: 'grepbot:resources',
    SEEN:     'grepbot:seen',
    TOWNS:    'grepbot:towns',
    TOWN_RES: 'grepbot:town-resources',
    THRESH:   'grepbot:thresholds',
    ALERTED:  'grepbot:alerted',
    COLLECT_ALL: 'grepbot:collect-all',
    COLLECT_TPL: 'grepbot:collect-tpl',
    AUTO_BANDIT: 'grepbot:auto-bandit',
    BANDIT_LOG:  'grepbot:bandit-log',
    NEXT_FARM:  'grepbot:next-farm',
    NEXT_TOWNS: 'grepbot:next-towns',
    FARM_ACTION: 'grepbot:farm-action',
    AUTO_FARM:  'grepbot:auto-farm',
    CLAIM_TPL:  'grepbot:claim-tpl',
  };

  const state = {
    findings: load(STORE.FINDINGS, []),
    farms:    load(STORE.FARMS, ''),
    farmsParsed: load(STORE.FARMS_PARSED, []),
    farmResources: load(STORE.FARM_RES, {}),
    seen:     load(STORE.SEEN, {}),
    towns:    load(STORE.TOWNS, []),
    townResources: load(STORE.TOWN_RES, {}),
    thresholds: load(STORE.THRESH, {}),
    alerted:  load(STORE.ALERTED, {}),
    csrf:     null,
    dirty:    false,
    lastSync: load('grepbot:lastSync', 0),
    lastSyncErr: null,
    nextFarmScrape: load(STORE.NEXT_FARM, 0),
    nextTownsScrape: load(STORE.NEXT_TOWNS, 0),
    farmAction: load(STORE.FARM_ACTION, null),
    collectAll: load(STORE.COLLECT_ALL, false),
    collectTpl: load(STORE.COLLECT_TPL, null),
    autoBandit: load(STORE.AUTO_BANDIT, false),
    banditLog:  load(STORE.BANDIT_LOG, []),
    autoFarm:   load(STORE.AUTO_FARM, true),
    claimTpl:   load(STORE.CLAIM_TPL, null),
  };

  let panel = null;

  // ---------- logging ----------
  // Everything goes to console.info AND the panel's Log tab (ring buffer)
  // AND a relay queue streamed to the local server (/api/log) every 10s.
  const logBuf = [];
  const logThrottle = new Map();
  const LOG_MAX = 200;
  const LOG_ENDPOINT = 'http://127.0.0.1:35657/api/log';
  const logRelayQueue = [];
  let logRelayTimer = null;
  function gbLog(...args) {
    console.info('[grepbot]', ...args);
    const msg = args.map(a => (typeof a === 'string' ? a : (() => { try { return JSON.stringify(a); } catch (_) { return String(a); } })())).join(' ');
    logBuf.push({ ts: Date.now(), msg });
    if (logBuf.length > LOG_MAX) logBuf.splice(0, logBuf.length - LOG_MAX);
    logRelayQueue.push({ ts: Date.now(), msg });
    if (logRelayQueue.length > 300) logRelayQueue.splice(0, logRelayQueue.length - 300);
    if (!logRelayTimer) logRelayTimer = setTimeout(() => { logRelayTimer = null; relayLogs(); }, 10000);
    renderLog();
  }
  function relayLogs() {
    const batch = logRelayQueue.splice(0, logRelayQueue.length);
    if (!batch.length) return;
    GM_xmlhttpRequest({
      method: 'POST',
      url: LOG_ENDPOINT,
      headers: { 'Content-Type': 'application/json' },
      data: JSON.stringify({ v: runningVersion(), host: location.host, lines: batch }),
      onload(r) { if (!(r && r.status >= 200 && r.status < 300)) logRelayQueue.unshift(...batch); },
      onerror() { logRelayQueue.unshift(...batch); },
    });
  }
  // same key logged at most once per ms — for decisions made inside hot loops
  function gbLogT(key, ms, ...args) {
    const now = Date.now();
    if ((logThrottle.get(key) || 0) + ms > now) return;
    logThrottle.set(key, now);
    gbLog(...args);
  }
  function renderLog() {
    const list = panel && panel.querySelector('.log-list');
    if (!list) return;
    const lines = logBuf.slice(-80);
    list.textContent = lines.map(l => new Date(l.ts).toLocaleTimeString() + ' ' + l.msg).join('\n');
    list.scrollTop = list.scrollHeight;
  }

  // ---------- game bridge ----------
  // ModernBot-style: read the game's own backbone models instead of scraping
  // DOM/guessing endpoints, and send actions through gpAjax (auto-signs csrf).
  function gameUw() {
    try {
      if (typeof unsafeWindow !== 'undefined' && unsafeWindow) return unsafeWindow;
    } catch (_) {}
    try { return window.wrappedJSObject || window; } catch (_) { return window; }
  }
  function gameBridgeStatus() {
    const uw = gameUw();
    const s = { uw: !!uw, Game: false, MM: false, gpAjax: false, ITowns: false, GameData: false, farmRel: false, farmTown: false, townCol: false, attackSpot: false };
    try {
      s.Game = !!uw.Game;
      s.MM = !!uw.MM;
      s.gpAjax = !!(uw.gpAjax && uw.gpAjax.ajaxPost);
      s.ITowns = !!(uw.ITowns && uw.ITowns.towns);
      s.GameData = !!(uw.GameData && uw.GameData.units);
      if (s.MM) {
        s.farmRel = !!uw.MM.getOnlyCollectionByName('FarmTownPlayerRelation');
        s.farmTown = !!uw.MM.getOnlyCollectionByName('FarmTown');
        s.townCol = !!uw.MM.getOnlyCollectionByName('Town');
        s.attackSpot = !!uw.MM.getModelByNameAndPlayerId('PlayerAttackSpot');
      }
    } catch (_) {}
    return s;
  }
  function gameBridgeReady() {
    const s = gameBridgeStatus();
    return s.MM && s.gpAjax && s.ITowns;
  }

  const SYNC = {
    ENDPOINT: 'http://127.0.0.1:35657/api/findings',
    INTERVAL_MS: 60000,
    FARM_MIN_MS: 5 * 60 * 1000,
    FARM_MAX_MS: 6 * 60 * 1000,
  };

  // ---------- storage ----------
  function load(key, fallback) {
    try { const v = GM_getValue(key, null); return v === null ? fallback : v; }
    catch (e) { return fallback; }
  }
  function save(key, val) {
    try { GM_setValue(key, val); } catch (e) { console.warn('[grepbot] save fail', key, e); }
  }

  // ---------- csrf / token hunt ----------
  function huntCsrf() {
    const w = unsafeWindow;
    const candidates = [
      () => w.csrfToken,
      () => w.csrf_token,
      () => w.h,
      () => w.Game && w.Game.csrfToken,
      () => w.Game && w.Game.h,
      () => document.querySelector('meta[name="csrf-token"]')?.content,
      () => document.querySelector('meta[name="h"]')?.content,
      () => document.querySelector('input[name="h"]')?.value,
      () => document.querySelector('input[name="csrfToken"]')?.value,
      // any element with data-h
      () => document.querySelector('[data-h]')?.getAttribute('data-h'),
      // cookie
      () => {
        const m = document.cookie.match(/(?:^|;\s*)(?:h|csrf)=([a-f0-9]{16,})/i);
        return m ? m[1] : null;
      },
    ];
    for (const fn of candidates) {
      try {
        const v = fn();
        if (v && /^[a-f0-9]{16,}$/i.test(String(v))) return String(v);
      } catch (_) {}
    }
    return null;
  }
  (function csrfLoop() {
    const fresh = huntCsrf();
    if (fresh && fresh !== state.csrf) { state.csrf = fresh; gbLog('csrf found', fresh.slice(0,6)+'…'); }
    else if (!fresh && !state.csrf) gbLogT('csrf-miss', 60000, 'csrf not found yet — retrying');
    setTimeout(csrfLoop, state.csrf ? 30000 : 5000);
  })();

  // ---------- ajax spy ----------
  // Grepolis uses jQuery + fetch. Hook both, watch for report ids.
  const seenThisRun = new Set();

  function hookFetch() {
    const orig = unsafeWindow.fetch;
    if (orig._grepbot) return;
    unsafeWindow.fetch = function patched(...args) {
      const [url, opts] = args;
      const u = String(url || '');
      const m = u.match(/action=(report|reports|combat_reports|tombstone|attack_planner)/);
      const idMatch = u.match(/[?&]id=(\d+)/);
      if (m && idMatch) queueReport(idMatch[1], u);
      else if (m) queueReportList(u);
      learnCollectAction(u);
      learnFarmAction(u);
      return orig.apply(this, args);
    };
    unsafeWindow.fetch._grepbot = true;
  }

  function hookXhr() {
    if (!unsafeWindow.XMLHttpRequest) return;
    const P = unsafeWindow.XMLHttpRequest.prototype;
    if (P._grepbot_open) return;
    const origOpen = P.open;
    const origSend = P.send;
    P.open = function (method, url) {
      this._grepbot_url = url;
      return origOpen.apply(this, arguments);
    };
    P.send = function () {
      const u = String(this._grepbot_url || '');
      const idMatch = u.match(/[?&]id=(\d+)/);
      if (/action=(report|reports|combat_reports|tombstone|attack_planner)/.test(u) && idMatch) {
        queueReport(idMatch[1], u);
      } else if (/action=(reports|combat_reports|tombstone)/.test(u)) {
        queueReportList(u);
      }
      learnCollectAction(u);
      learnFarmAction(u);
      sniffBridgeBody(u, arguments[0]);
      this.addEventListener('load', () => {
        try {
          const data = JSON.parse(this.responseText || '{}');
          scanResponseForReports(data, u);
        } catch (_) {}
      });
      return origSend.apply(this, arguments);
    };
    P._grepbot_open = true;
  }

  function scanResponseForReports(data, srcUrl) {
    if (!data || typeof data !== 'object') return;
    // Grepolis wraps in {json: {...}, ...} or returns arrays directly
    const collect = (obj) => {
      if (!obj) return;
      if (Array.isArray(obj)) { obj.forEach(collect); return; }
      if (typeof obj !== 'object') return;
      for (const k of Object.keys(obj)) {
        const v = obj[k];
        if ((k === 'id' || k === 'report_id') && typeof v === 'number') queueReport(String(v), srcUrl);
        else if (k === 'reports' && Array.isArray(v)) v.forEach(r => r && r.id && queueReport(String(r.id), srcUrl));
        else collect(v);
      }
    };
    collect(data);
  }

  // ---------- report fetching ----------
  function queueReport(id, hintUrl) {
    if (!id || seenThisRun.has(id) || state.seen[id]) return;
    seenThisRun.add(id);
    setTimeout(() => fetchReport(id, hintUrl), 200 + Math.random() * 800);
  }
  function queueReportList() {
    // best-effort: scrape current inbox DOM if present
    setTimeout(scrapeInboxDom, 1500);
  }

  function fetchReport(id, hintUrl) {
    if (state.seen[id]) return;
    const u = buildReportUrl(id, hintUrl);
    GM_xmlhttpRequest({
      method: 'GET',
      url: u,
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json, text/plain, */*' },
      anonymous: false,
      onload(res) {
        state.seen[id] = Date.now();
        save(STORE.SEEN, state.seen);
        try {
          const data = JSON.parse(res.responseText);
          const parsed = parseReport(id, data);
          if (parsed) {
            state.findings.unshift(parsed);
            if (state.findings.length > 500) state.findings.length = 500;
            save(STORE.FINDINGS, state.findings);
            state.dirty = true;
            renderFindings();
            updateSyncBadge();
            scheduleFlush();
          }
        } catch (e) {
          console.warn('[grepbot] parse fail', id, e);
        }
      },
      onerror(e) { console.warn('[grepbot] report fail', id, e); },
    });
  }

  function buildReportUrl(id, hintUrl) {
    const base = '/index.php?';
    const params = new URLSearchParams();
    params.set('action', 'report');
    params.set('id', id);
    if (state.csrf) params.set('h', state.csrf);
    // Mirror hint params (town_id, attack_type, type) when present
    if (hintUrl) {
      try {
        const hp = new URL(hintUrl, location.origin).searchParams;
        ['town_id','attack_type','type'].forEach(k => { if (hp.has(k)) params.set(k, hp.get(k)); });
      } catch (_) {}
    }
    return base + params.toString();
  }

  function parseReport(id, data) {
    // Grepolis response shape: { json: {...}, html: "...", ... } or raw.
    const json = (data && data.json) ? data.json : data;
    const r = (json && json.report) || json || {};
    const now = Date.now();
    const out = {
      id, ts: now,
      type: r.type || r.report_type || 'unknown',
      attacker: nameOf(r.attacker),
      defender: nameOf(r.defender),
      town: {
        id: r.defender?.town_id || r.town_id || null,
        name: r.defender?.town_name || r.town_name || null,
        x: r.defender?.x ?? r.x ?? null,
        y: r.defender?.y ?? r.y ?? null,
      },
      units: extractUnits(r),
      resources: extractResources(r),
      loot: r.resources || null,
      outcome: r.outcome || r.win || null,
      raw: r,
    };
    return out;
  }
  function nameOf(p) { return p ? { id: p.id ?? p.player_id, name: p.name || p.player_name || null } : null; }
  function extractUnits(r) {
    const u = {};
    const src = r.units || r.attacker_units || {};
    Object.keys(src).forEach(k => { const v = src[k]; if (typeof v === 'number' && v > 0) u[k] = v; });
    return Object.keys(u).length ? u : null;
  }
  function extractResources(r) {
    const src = r.resources || r.loot || {};
    return {
      wood: src.wood ?? null, stone: src.stone ?? null, iron: src.iron ?? null,
      gold: src.gold ?? null, supply: src.supply ?? null,
    };
  }

  function scrapeInboxDom() {
    // fallback: read report ids from rendered inbox list
    document.querySelectorAll('a[href*="action=report"][href*="id="]').forEach(a => {
      const m = a.href.match(/id=(\d+)/);
      if (m) queueReport(m[1], a.href);
    });
  }

  // ---------- farm parser + resource scraper ----------
  function parseFarms(text) {
    return text.split('\n').map(l => l.trim()).filter(Boolean).map(line => {
      const parts = line.split('|').map(s => s.trim());
      let id = parts[0] && /^\d+$/.test(parts[0]) ? parts[0] : null;
      if (!id) {
        // tolerate "12345 500 600 | notes" (no leading pipe)
        const m = line.match(/^(\d{4,})\s+/);
        if (m) id = m[1];
      }
      if (!id) return null;
      const out = { vill_id: id, x: null, y: null, eta: null, notes: null };
      const coordMatch = line.match(/(-?\d{1,4})[,\s]+(-?\d{1,4})/);
      if (coordMatch) { out.x = +coordMatch[1]; out.y = +coordMatch[2]; }
      for (const p of parts) {
        if (/^\d+[hm]$/i.test(p) || /^\d{1,2}:\d{2}$/.test(p)) { out.eta = p; break; }
      }
      const skip = new Set([out.eta, out.x != null ? `${out.x} ${out.y}` : null, `${out.x},${out.y}`, id]);
      out.notes = parts.slice(1).filter(p => p && !skip.has(p)).join(' | ') || null;
      return out;
    }).filter(Boolean);
  }

  function refreshFarmsParsed() {
    state.farmsParsed = mergedFarms();
    save(STORE.FARMS_PARSED, state.farmsParsed);
  }

  // ---------- sniff the game's own bridge calls (learn exact payload shapes) ----------
  // When the user clicks Recoger / attacks manually, the real request body is
  // captured here and used as the template for our automated calls.
  function parseBodyLoose(s) {
    let j = null;
    try { j = JSON.parse(s); } catch (_) {}
    if (!j) {
      try {
        const p = new URLSearchParams(s);
        j = {};
        for (const [k, v] of p) { try { j[k] = JSON.parse(v); } catch (_) { j[k] = v; } }
      } catch (_) { return null; }
    }
    // grepolis sometimes wraps: {"json": "<stringified payload>"}
    if (j && typeof j.json === 'string') {
      try { const inner = JSON.parse(j.json); if (inner && inner.model_url) return inner; } catch (_) {}
    }
    return j;
  }
  function sniffBridgeBody(u, body) {
    try {
      if (!body || typeof body !== 'string' || !/frontend_bridge/.test(String(u))) return;
      if (/FarmTownPlayerRelation/.test(body)) {
        gbLog('sniffed farm bridge call:', body.slice(0, 300));
        const j = parseBodyLoose(body);
        if (j && j.model_url && /claim/i.test(j.action_name || '')) {
          state.claimTpl = { model_url: j.model_url, action_name: j.action_name, arguments: j.arguments || {}, town_id: j.town_id };
          save(STORE.CLAIM_TPL, state.claimTpl);
          gbLog('learned claim template:', JSON.stringify(state.claimTpl).slice(0, 200));
        }
      } else if (/PlayerAttackSpot/.test(body)) {
        gbLog('sniffed bandit bridge call:', body.slice(0, 300));
      }
    } catch (_) {}
  }

  // ---------- farms via game data (ModernBot style) ----------
  // FarmTownPlayerRelation: per-player claim state (lootable_at, relation_status)
  // FarmTown: village identity + island coords. No HTTP, always fresh.
  let farmRelLogged = false;
  function farmsFromGame() {
    const uw = gameUw();
    try {
      if (!uw.MM) return null;
      let relCol = null;
      try { relCol = uw.MM.getOnlyCollectionByName('FarmTownPlayerRelation'); } catch (_) {}
      if (!relCol || !relCol.models) {
        try { relCol = ((uw.MM.getCollections && uw.MM.getCollections().FarmTownPlayerRelation) || [])[0]; } catch (_) {}
      }
      let farmCol = null;
      try { farmCol = uw.MM.getOnlyCollectionByName('FarmTown'); } catch (_) {}
      if (!relCol || !relCol.models) return null;
      const farmById = {};
      ((farmCol && farmCol.models) || []).forEach(m => { const a = m.attributes || {}; farmById[a.id] = a; });
      const out = [];
      const statusCount = {};
      let noRelId = 0;
      relCol.models.forEach(r => {
        const a = r.attributes || {};
        statusCount[a.relation_status] = (statusCount[a.relation_status] || 0) + 1;
        if (a.relation_status !== 1) return; // not under our control
        const relId = r.id ?? a.id;
        if (relId == null) { noRelId++; return; }
        const f = farmById[a.farm_town_id] || {};
        out.push({
          vill_id: String(a.farm_town_id),
          relation_id: relId,
          x: f.island_x ?? null,
          y: f.island_y ?? null,
          lootable_at: a.lootable_at ?? null,
          name: f.name || null,
          fromGame: true,
        });
      });
      if (!farmRelLogged) {
        farmRelLogged = true;
        gbLog(`farm relations: ${relCol.models.length} total, statuses ${JSON.stringify(statusCount)}, controlled ${out.length}${noRelId ? `, ${noRelId} missing relation id` : ''}`);
      }
      return out;
    } catch (e) { gbLogT('farmsFromGame', 60000, 'farmsFromGame fail', String(e)); return null; }
  }
  function mergedFarms() {
    const game = farmsFromGame() || [];
    const manual = parseFarms(state.farms);
    const seen = new Set(game.map(f => f.vill_id));
    return game.concat(manual.filter(f => !seen.has(f.vill_id)));
  }
  // a town of ours on the same island as the farm — needed as claim town_id
  function townIdForFarm(farm) {
    const uw = gameUw();
    try {
      const towns = uw.ITowns.towns || {};
      for (const tid of Object.keys(towns)) {
        const t = towns[tid];
        if (t.getIslandCoordinateX && t.getIslandCoordinateX() === farm.x &&
            t.getIslandCoordinateY && t.getIslandCoordinateY() === farm.y) return tid;
      }
    } catch (_) {}
    return uw.Game && uw.Game.townId;
  }
  // collect ready loot + start next gather, straight through the game's bridge.
  // arguments shape copied from the sniffed real claim when available.
  function claimFarm(farm) {
    const uw = gameUw();
    const tplArgs = (state.claimTpl && state.claimTpl.arguments) || {};
    const args = Object.assign({ type: 'resources', option: 1 }, tplArgs);
    args.farm_town_id = +farm.vill_id;
    uw.gpAjax.ajaxPost('frontend_bridge', 'execute', {
      model_url: `FarmTownPlayerRelation/${farm.relation_id}`,
      action_name: (state.claimTpl && state.claimTpl.action_name) || 'claim',
      arguments: args,
      town_id: +townIdForFarm(farm),
    });
  }
  function autoClaimFarms(reason) {
    if (!state.autoFarm) return;
    const uw = gameUw();
    if (!(uw.gpAjax && uw.gpAjax.ajaxPost)) { gbLogT('claim-noajax', 60000, 'farm claim: gpAjax not ready yet'); return; }
    const farms = farmsFromGame();
    if (!farms) { gbLogT('claim-nofarms', 60000, 'farm claim: game collections not ready'); return; }
    const now = Math.floor(Date.now() / 1000);
    const ready = farms.filter(f => f.lootable_at == null || f.lootable_at <= now);
    if (!ready.length) {
      const next = Math.min(...farms.map(f => f.lootable_at || Infinity));
      gbLogT('claim-none', 60000, `farm claim: 0/${farms.length} ready, next in ${next === Infinity ? '?' : Math.max(0, next - now) + 's'}`);
      return;
    }
    gbLog(`farm claim${reason ? ' (' + reason + ')' : ''}: ${ready.length}/${farms.length} ready`);
    const before = {};
    farms.forEach(f => { before[f.vill_id] = f.lootable_at; });
    ready.forEach((f, i) => setTimeout(() => {
      try {
        claimFarm(f);
        gbLog(`  claimed ${f.name || f.vill_id} (rel ${f.relation_id})`);
      } catch (e) { gbLog('  claim FAIL', f.vill_id, String(e)); }
    }, i * 700));
    flash(`farm claim ×${ready.length}`);
    // verify the server actually accepted the claims: relations should flip to
    // a fresh future lootable_at once the new gather starts
    setTimeout(() => verifyClaims(before), 10000 + ready.length * 700);
  }
  function verifyClaims(before) {
    const farms = farmsFromGame();
    if (!farms) return;
    const now = Math.floor(Date.now() / 1000);
    let updated = 0;
    farms.forEach(f => {
      if (f.lootable_at != null && f.lootable_at > now && before[f.vill_id] !== f.lootable_at) updated++;
    });
    gbLog(`farm claim verify: ${updated} village(s) now gathering${updated ? '' : ' — claims did NOT land (open Senado once, click Recoger manually, then paste me the Log tab)'}`);
  }

  // farm_town_* actions are the real farming-village endpoints; the rest are
  // town-shaped fallbacks. First action that works gets cached + tried first.
  const ACTION_GUESSES = ['farm_town_info', 'get_farm_towns', 'farm_town_overview', 'town_info', 'get_town_info', 'town_overview', 'overview_towns', 'get_resources', 'resource_header'];
  function farmGuesses() {
    const g = ACTION_GUESSES.slice();
    const a = state.farmAction;
    if (a) {
      const i = g.indexOf(a);
      if (i >= 0) g.splice(i, 1);
      g.unshift(a);
    }
    return g;
  }
  // The game's own requests reveal the correct endpoint name for this world.
  function learnFarmAction(u) {
    const m = String(u || '').match(/[?&]action=([a-z_]+)/i);
    if (!m) return;
    const a = m[1].toLowerCase();
    if (!/farm|vill|island/.test(a) || state.farmAction === a) return;
    state.farmAction = a;
    save(STORE.FARM_ACTION, a);
    gbLog('learned farm action', a);
  }
  function fetchFarmResources(entry, onDone) {
    const guesses = farmGuesses();
    tryGuess(entry, 0);
    function tryGuess(entry, i) {
      if (i >= guesses.length) {
        state.farmResources[entry.vill_id] = { ts: Date.now(), ok: false, err: 'no endpoint matched' };
        save(STORE.FARM_RES, state.farmResources);
        renderFarms();
        if (onDone) onDone(false);
        return;
      }
      const action = guesses[i];
      const params = new URLSearchParams();
      params.set('action', action);
      params.set('town_id', entry.vill_id);
      if (state.csrf) params.set('h', state.csrf);
      const u = '/index.php?' + params.toString();
      GM_xmlhttpRequest({
        method: 'GET', url: u,
        anonymous: false,
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json, text/plain, */*' },
        onload(res) {
          const body = (res.responseText || '').slice(0, 500);
          // look for any resource-like key
          const looksLikeJson = res.responseText && (res.responseText[0] === '{' || res.responseText[0] === '[');
          if (!looksLikeJson || /<html/i.test(body)) {
            // try next action
            return tryGuess(entry, i + 1);
          }
          try {
            const data = JSON.parse(res.responseText);
            const json = (data && data.json) ? data.json : data;
            const r = (json && (json.town || json.town_info || json.resources || json)) || {};
            const res_ = r.resources || r.resource || {};
            const pop = r.population || r.pop || {};
            const wood = pickNum(res_.wood, r.wood, json.wood);
            const stone = pickNum(res_.stone, r.stone, json.stone);
            const iron = pickNum(res_.iron, r.iron, json.iron);
            // Grepolis overview often returns everything together; success if we got numbers or a name
            const got = wood != null || stone != null || iron != null || r.name || r.town_name;
            if (!got && i + 1 < guesses.length) return tryGuess(entry, i + 1);
            if (state.farmAction !== action) {
              state.farmAction = action;
              save(STORE.FARM_ACTION, action);
              gbLog('farm endpoint =', action);
            }
            state.farmResources[entry.vill_id] = {
              ts: Date.now(),
              wood, stone, iron,
              pop: pop.current ?? pop.pop ?? null,
              cap: pop.max ?? pop.cap ?? null,
              name: r.name || r.town_name || null,
              ok: true,
              action,
            };
          } catch (e) {
            if (i + 1 < guesses.length) return tryGuess(entry, i + 1);
            state.farmResources[entry.vill_id] = { ts: Date.now(), ok: false, err: String(e).slice(0, 100) };
          }
          save(STORE.FARM_RES, state.farmResources);
          state.dirty = true; updateSyncBadge(); scheduleFlush();
          renderFarms();
          checkThresholds();
          if (onDone) onDone(!!state.farmResources[entry.vill_id].ok);
        },
        onerror() {
          if (i + 1 < guesses.length) return tryGuess(entry, i + 1);
          state.farmResources[entry.vill_id] = { ts: Date.now(), ok: false, err: 'network' };
          save(STORE.FARM_RES, state.farmResources);
          renderFarms();
          if (onDone) onDone(false);
        },
      });
    }
  }
  function pickNum(...candidates) {
    for (const c of candidates) {
      if (typeof c === 'number' && Number.isFinite(c)) return c;
      if (typeof c === 'string' && /^-?\d+(\.\d+)?$/.test(c)) return Number(c);
    }
    return null;
  }

  // Deadline-based scheduling: a chained setTimeout gets throttled arbitrarily
  // (observed ~20min) in background tabs, so we persist a deadline and let a
  // short ticker fire the scrape. Overshoot is bounded by the tick interval.
  function scrapeAllFarms() {
    refreshFarmsParsed();
    const wait = SYNC.FARM_MIN_MS + Math.random() * (SYNC.FARM_MAX_MS - SYNC.FARM_MIN_MS);
    state.nextFarmScrape = Date.now() + wait;
    save(STORE.NEXT_FARM, state.nextFarmScrape);
    renderTimers();
    const list = state.farmsParsed.slice();
    const gameFarms = list.filter(f => f.fromGame).length;
    if (!list.length) { gbLog('farm scrape: 0 farms known (no game data, textarea empty)'); return; }
    gbLog(`farm scrape: ${list.length} farms (${gameFarms} auto-discovered, ${list.length - gameFarms} from textarea)`);
    let done = 0, ok = 0;
    // strictly sequential: parallel bursts of N farms x endpoint guesses get
    // throttled by the game server, which is why only the first farm updated
    (function step() {
      const f = list.shift();
      if (!f) {
        gbLog(`farm scrape done: ${ok}/${done} ok, next in ${fmtSec(Math.round(wait / 1000))}`);
        flash(`farms ${ok}/${done} ok`);
        return;
      }
      fetchFarmResources(f, (good) => {
        done++; if (good) ok++;
        if (!good) gbLog(`  farm ${f.vill_id}: no data (${(state.farmResources[f.vill_id] || {}).err || '?'})`);
        setTimeout(step, 700 + Math.random() * 300);
      });
    })();
  }

  function farmTick() {
    const now = Date.now();
    if (now >= state.nextFarmScrape) scrapeAllFarms();
    if (now >= state.nextTownsScrape) scrapeAllTowns();
  }

  // ---------- owned towns ----------
  // Prefer the game's own collections — zero requests, always correct.
  function townsFromGame() {
    const uw = gameUw();
    try {
      const col = uw.MM && uw.MM.getOnlyCollectionByName && uw.MM.getOnlyCollectionByName('Town');
      if (!col || !col.models || !col.models.length) return null;
      return col.models.map(m => {
        const a = m.attributes || {};
        return { id: String(a.id), name: a.name || null, x: a.island_x ?? null, y: a.island_y ?? null, island: a.island_id ?? null };
      });
    } catch (e) { return null; }
  }
  function townResourcesFromGame(id) {
    const uw = gameUw();
    try {
      const t = uw.ITowns && (uw.ITowns.getTown ? uw.ITowns.getTown(id) : uw.ITowns.towns[id]);
      if (!t || !t.resources) return null;
      const r = t.resources();
      if (!r || r.wood == null) return null;
      return r;
    } catch (_) { return null; }
  }
  const TOWN_LIST_GUESSES = ['get_towns', 'towns_overview', 'get_owned_towns', 'overview_towns', 'town_list'];
  function fetchOwnedTowns(i = 0) {
    if (!state.csrf) return;
    if (i >= TOWN_LIST_GUESSES.length) { scrapeTownsDom(); return; }
    const action = TOWN_LIST_GUESSES[i];
    const params = new URLSearchParams();
    params.set('action', action); params.set('h', state.csrf);
    const u = '/index.php?' + params.toString();
    GM_xmlhttpRequest({
      method: 'GET', url: u,
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      onload(res) {
        const body = (res.responseText || '').slice(0, 2000);
        if (!body || body[0] !== '{') return fetchOwnedTowns(i + 1);
        try {
          const data = JSON.parse(res.responseText);
          const json = (data && data.json) ? data.json : data;
          const list = extractTowns(json);
          if (list && list.length) {
            state.towns = list;
            save(STORE.TOWNS, state.towns);
            renderWorld();
            console.info('[grepbot] towns:', list.length, 'via', action);
            return;
          }
        } catch (e) { /* try next */ }
        fetchOwnedTowns(i + 1);
      },
      onerror() { fetchOwnedTowns(i + 1); },
    });
  }
  function extractTowns(json) {
    if (!json) return null;
    const out = [];
    const tryArr = (arr) => {
      if (!Array.isArray(arr)) return false;
      for (const t of arr) {
        if (!t || typeof t !== 'object') continue;
        const id = t.id ?? t.town_id;
        if (!id) continue;
        out.push({ id: String(id), name: t.name || null, x: t.x ?? null, y: t.y ?? null, island: t.island_id ?? null });
      }
      return out.length > 0;
    };
    if (tryArr(json)) return out;
    if (tryArr(json.towns)) return out;
    if (tryArr(json.owned_towns)) return out;
    const walk = (obj) => {
      if (!obj || typeof obj !== 'object') return;
      if (Array.isArray(obj)) { obj.forEach(walk); return; }
      for (const k of Object.keys(obj)) {
        const v = obj[k];
        if (k === 'towns' && Array.isArray(v)) tryArr(v);
        else if (v && typeof v === 'object') walk(v);
      }
    };
    walk(json);
    return out.length ? out : null;
  }
  function scrapeTownsDom() {
    document.querySelectorAll('[data-townid], a[data-town-id]').forEach(a => {
      const id = a.getAttribute('data-townid') || a.getAttribute('data-town-id');
      if (!id || state.towns.find(t => t.id === id)) return;
      state.towns.push({ id: String(id), name: (a.textContent || '').trim() || null });
    });
    save(STORE.TOWNS, state.towns);
    renderWorld();
  }
  function fetchTownResources(town) {
    tryGuess(town, 0);
    function tryGuess(town, i) {
      if (i >= ACTION_GUESSES.length) {
        state.townResources[town.id] = { ts: Date.now(), ok: false, err: 'no endpoint' };
        save(STORE.TOWN_RES, state.townResources);
        renderWorld();
        return;
      }
      const action = ACTION_GUESSES[i];
      const params = new URLSearchParams();
      params.set('action', action); params.set('town_id', town.id); params.set('h', state.csrf);
      const u = '/index.php?' + params.toString();
      GM_xmlhttpRequest({
        method: 'GET', url: u,
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        anonymous: false,
        onload(res) {
          const body = (res.responseText || '').slice(0, 500);
          if (!body || body[0] !== '{' || /<html/i.test(body)) return tryGuess(town, i + 1);
          try {
            const data = JSON.parse(res.responseText);
            const json = (data && data.json) ? data.json : data;
            const r = (json && (json.town || json.town_info || json)) || {};
            const res_ = r.resources || r.resource || {};
            const pop = r.population || r.pop || {};
            const wood = pickNum(res_.wood, r.wood, json.wood);
            const stone = pickNum(res_.stone, r.stone, json.stone);
            const iron = pickNum(res_.iron, r.iron, json.iron);
            if (wood == null && stone == null && iron == null && !r.name) return tryGuess(town, i + 1);
            state.townResources[town.id] = {
              ts: Date.now(), wood, stone, iron,
              pop: pop.current ?? pop.pop ?? null, cap: pop.max ?? pop.cap ?? null, ok: true, action,
            };
            save(STORE.TOWN_RES, state.townResources);
            renderWorld();
          } catch (e) { tryGuess(town, i + 1); }
        },
        onerror() { tryGuess(town, i + 1); },
      });
    }
  }
  function scrapeAllTowns() {
    const delay = SYNC.FARM_MAX_MS + Math.random() * 60000;
    state.nextTownsScrape = Date.now() + delay;
    save(STORE.NEXT_TOWNS, state.nextTownsScrape);
    renderTimers();
    const gameTowns = townsFromGame();
    if (gameTowns && gameTowns.length) {
      if (gameTowns.length !== state.towns.length) gbLog(`towns: ${gameTowns.length} from game data`);
      state.towns = gameTowns;
      save(STORE.TOWNS, state.towns);
    } else if (!state.towns.length) {
      gbLogT('towns-fallback', 300000, 'towns: game data unavailable, HTTP fallback');
      fetchOwnedTowns();
    }
    let fromGame = 0, fromHttp = 0;
    state.towns.forEach((t, i) => {
      const r = townResourcesFromGame(t.id);
      if (r) {
        fromGame++;
        state.townResources[t.id] = {
          ts: Date.now(), wood: r.wood ?? null, stone: r.stone ?? null, iron: r.iron ?? null,
          pop: r.population ?? null, cap: r.storage ?? null, ok: true, action: 'game-data',
        };
      } else {
        fromHttp++;
        setTimeout(() => fetchTownResources(t), fromHttp * 600);
      }
    });
    save(STORE.TOWN_RES, state.townResources);
    renderWorld();
    gbLog(`towns scrape: ${state.towns.length} towns (${fromGame} via game data, ${fromHttp} via HTTP)`);
    state.dirty = true; scheduleFlush();
  }

  // ---------- auto-collect short gathers (Senado / Reunir recursos) ----------
  // Grepolis DOM: button is <div class="btn_claim_resources ..."> with sibling <span>Recoger</span>.
  // Time lives in sibling .action_card > .action_time_wrapper > .action_time (formats: "5min", "1h 30min", "4h").
  // The button always has CSS classes "disabled active" — that's state styling, not actual disable.
  // We auto-click only short timers (<= COLLECT_MAX_MIN) unless "Collect all" is on.
  const COLLECT_MAX_MIN = 10;
  const COLLECT_ACTIONS = [
    'collect', 'collect_resources', 'collectresources', 'collect_resource',
    'claim', 'claim_resources', 'claimreward', 'claimrewardresource',
    'gather', 'recoger', 'pickup', 'pick_up',
  ];
  const COLLECT_BTN_SEL = '.btn_claim_resources, button[data-action*="claim"], a[data-action*="claim"]';
  function parseTimerMinutes(txt) {
    const t = String(txt || '').trim().toLowerCase();
    if (!t) return null;
    let m = t.match(/^(\d{1,2})\s*min$/);
    if (m) return parseInt(m[1], 10);
    m = t.match(/^(\d+)\s*h(?:\s*(\d+)\s*min)?$/);
    if (m) return parseInt(m[1], 10) * 60 + (m[2] ? parseInt(m[2], 10) : 0);
    return null;
  }
  function learnCollectAction(u) {
    if (!u || state.collectTpl) return;
    const m = u.match(/[?&]action=([a-z_]+)/i);
    if (!m) return;
    const a = m[1].toLowerCase();
    if (!COLLECT_ACTIONS.includes(a)) return;
    state.collectTpl = u;
    save(STORE.COLLECT_TPL, u);
    gbLog('learned collect action', a);
  }
  function buildCollectUrl(template, townId) {
    try {
      const u = new URL(template, location.origin);
      u.searchParams.set('town_id', String(townId));
      u.searchParams.set('h', state.csrf || u.searchParams.get('h') || '');
      return u.pathname + '?' + u.searchParams.toString();
    } catch (e) {
      return template.replace(/town_id=\d+/, `town_id=${townId}`);
    }
  }
  function autoCollectResources() {
    const btns = Array.from(document.querySelectorAll(COLLECT_BTN_SEL));
    let clicked = 0, scanned = btns.length;
    const skipped = [];
    for (const btn of btns) {
      if (btn.dataset.grepbotClicked) { skipped.push('already-clicked'); continue; }
      const card = btn.closest('.action_card') || btn.closest('[class*="action_card"]') || btn.parentElement;
      if (!card) { skipped.push('no-card'); continue; }
      const timeEl = card.querySelector('.action_time');
      if (!timeEl) { skipped.push('no-time'); continue; }
      const min = parseTimerMinutes(timeEl.textContent);
      if (min == null || min === 0) { skipped.push('no-parse:' + (timeEl.textContent||'').trim()); continue; }
      if (!state.collectAll && min > COLLECT_MAX_MIN) { skipped.push(`too-long:${min}min`); continue; }
      btn.dataset.grepbotClicked = String(Date.now());
      btn.click();
      clicked++;
    }
    updateCollectStateBadge(scanned, clicked);
    if (clicked) { gbLog(`auto-collect: clicked ${clicked}/${scanned} Recoger buttons`); flash(`auto-collect ×${clicked}`); }
    else if (scanned > 0) gbLogT('collect-skip', 120000, `auto-collect: 0/${scanned} clickable`, skipped.slice(0, 4).join(', '));
  }
  function updateCollectStateBadge(scanned, clicked) {
    const e = panel?.querySelector('#gb-collect-state');
    if (!e) return;
    if (state.collectAll) {
      e.textContent = `⚡ ALL ON (${scanned}/${clicked})`;
      e.style.color = '#f96';
    } else if (scanned > 0) {
      e.textContent = `auto: ${clicked}/${scanned}`;
      e.style.color = clicked ? '#6c6' : '#888';
    } else {
      const a = state.collectTpl && state.collectTpl.match(/action=([^&]+)/);
      e.textContent = state.collectTpl ? '⚡ learn:' + (a ? a[1] : '?') : 'no btn';
      e.style.color = '#888';
    }
  }
  // background collect: fire the learned action URL for each owned town, no DOM/visibility needed
  function collectAllBackground() {
    if (!state.collectAll) return;
    if (!state.csrf) { setTimeout(collectAllBackground, 30_000); return; }
    if (!state.collectTpl) { scheduleAutoCollect(); setTimeout(collectAllBackground, 60_000); return; }
    if (!state.towns.length) fetchOwnedTowns();
    let fired = 0;
    state.towns.forEach((t, i) => {
      setTimeout(() => {
        const u = buildCollectUrl(state.collectTpl, t.id);
        GM_xmlhttpRequest({
          method: 'GET', url: u,
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
          anonymous: false,
          onload(res) {
            try {
              const body = res.responseText || '';
              if (body[0] === '{') {
                const j = JSON.parse(body);
                if (j && (j.error || j.err)) flash(`collect ${t.name || t.id}: ${j.error || j.err}`);
              }
            } catch (_) {}
          },
        });
        fired++;
      }, i * 400);
    });
    flash(`bg-collect ×${state.towns.length}`);
    setTimeout(collectAllBackground, 90_000 + Math.random() * 30_000);
  }
  let collectTimer = null;
  function scheduleAutoCollect() {
    if (collectTimer) return;
    collectTimer = setTimeout(() => { collectTimer = null; autoCollectResources(); }, 400);
  }
  // Single DOM observer drives both scanners; bandit arm gated on its toggle.
  const domObserver = new MutationObserver(() => {
    scheduleAutoCollect();
    if (state.autoBandit) scheduleBanditScan();
  });
  domObserver.observe(document.body, { childList: true, subtree: true });

  // ---------- auto-bandit: attack open bandit camps + claim reward ----------
  // Grepolis DOM:
  //   bandit camp window:   .window_content.js-window-content with .attack_spots, btn_attack
  //   victory window:       .attack_spot_victory with .btn_collect ("Recoger recompensa")
  //   cooldown text:        "Tienes que aguardar ... tiempo de espera ... próximo ataque" + countdown clock
  //   unit picker:          .unit_picker_container > .unit_picker > .units_box > .unit_container
  //   each unit:            .unit_icon40x40[data-unit_id] + .txt_unit input[type=text]
  //   select-all:           .select_all ("Seleccionar todas las unidades")
  // We auto-click btn_attack (when enabled + units picked) and btn_collect (victory).
  let banditTimer = null;
  // Model-driven bandit handling (ModernBot style). Returns true when the game
  // bridge is usable — no window needs to be open for any of this.
  function banditViaGame() {
    const uw = gameUw();
    let m = null;
    try { m = uw.MM && uw.MM.getModelByNameAndPlayerId && uw.MM.getModelByNameAndPlayerId('PlayerAttackSpot'); } catch (_) {}
    if (!m || !(uw.gpAjax && uw.gpAjax.ajaxPost)) return false;
    const post = (action_name, args) => uw.gpAjax.ajaxPost('frontend_bridge', 'execute', {
      model_url: `PlayerAttackSpot/${uw.Game.player_id}`, action_name, arguments: args,
    });
    try {
      // world has no bandit camp feature
      if (typeof m.getLevel === 'function' && m.getLevel() == null) { gbLogT('bandit-none', 300000, 'bandit: no camp on this world'); return true; }
      // 1. unclaimed reward?
      if (m.hasReward && m.hasReward()) {
        const r = (m.getReward && m.getReward()) || {};
        const pid = r.power_id || '';
        const action = (pid.includes('instant') && !pid.includes('favor')) ? 'useReward'
          : (r.stashable ? 'stashReward' : 'useReward');
        post(action, {});
        gbLog('bandit: reward claimed via', action, pid || '(no power_id)');
        flash('bandit: reward claimed');
        logBandit('collected');
        return true;
      }
      // 2. cooldown?
      const cd = m.getCooldownDuration ? m.getCooldownDuration() : 0;
      if (cd > 0) {
        gbLogT('bandit-cd', 60000, `bandit: cooldown ${Math.floor(cd / 60)}m${cd % 60}s left`);
        return true;
      }
      // 3. attack already marching?
      const moves = (uw.MM.getModels && uw.MM.getModels().MovementsUnits) || {};
      for (const k of Object.keys(moves)) {
        const a = moves[k].attributes || {};
        if (a.destination_is_attack_spot || a.origin_is_attack_spot) { gbLogT('bandit-enroute', 60000, 'bandit: attack already en route'); return true; }
      }
      // 4. attack with all land units of the current town
      const t = uw.ITowns && uw.ITowns.towns && uw.ITowns.towns[uw.Game.townId];
      if (!t || !t.units) { gbLogT('bandit-notown', 60000, 'bandit: current town units unavailable'); return true; }
      const units = Object.assign({}, t.units());
      delete units.militia;
      Object.keys(units).forEach(u => {
        try { if (uw.GameData.units[u].is_naval) delete units[u]; } catch (_) {}
        if (!units[u]) delete units[u];
      });
      if (!Object.keys(units).length) { gbLogT('bandit-nounits', 60000, 'bandit: no land units in current town'); return true; }
      post('attack', units);
      gbLog('bandit: ATTACK sent', JSON.stringify(units));
      flash('bandit: attack sent');
      logBandit('attack');
    } catch (e) { gbLog('bandit game-path fail', String(e)); }
    return true;
  }
  function banditScan() {
    if (!state.autoBandit) return;
    if (banditViaGame()) return;
    gbLogT('bandit-dom', 120000, 'bandit: game bridge unavailable, DOM fallback');
    // 1. claim victory reward if present
    const victory = document.querySelector('.attack_spot_victory .btn_collect, .attack_spot_victory .button_new.double_border');
    if (victory && !victory.dataset.grepbotClicked) {
      victory.dataset.grepbotClicked = String(Date.now());
      victory.click();
      gbLog('bandit: collected reward (DOM)');
      flash('bandit: collected reward');
      logBandit('collected');
      return;
    }
    // 2. find open bandit camp window
    const camps = document.querySelectorAll('.js-window-main-container.attack_spot:not(.minimized):not(.attack_spot_victory)');
    for (const camp of camps) {
      // cooldown check: if btn_attack is disabled or there's a countdown, skip
      const btn = camp.querySelector('.btn_attack');
      if (!btn) continue;
      const cdEl = camp.querySelector('.countdown, [class*="countdown"], .cooldown_time');
      if (cdEl && /\d/.test(cdEl.textContent || '')) continue; // still cooling
      const disabled = btn.classList.contains('disabled') || btn.disabled;
      if (disabled) continue;
      // fill units: "Seleccionar todas las unidades"
      const selectAll = camp.querySelector('.select_all');
      if (selectAll && !selectAll.dataset.grepbotClicked) {
        selectAll.dataset.grepbotClicked = String(Date.now());
        selectAll.click();
        // give the unit_picker a moment to update maxlength/values
        setTimeout(() => {
          const atkBtn = camp.querySelector('.btn_attack');
          if (atkBtn && !atkBtn.classList.contains('disabled') && !atkBtn.disabled) {
            atkBtn.dataset.grepbotClicked = String(Date.now());
            atkBtn.click();
            gbLog('bandit: attack sent (DOM, select-all)');
            flash('bandit: attack sent');
            logBandit('attack');
          }
        }, 250);
        return;
      }
      // no select_all button visible, fall back to per-unit MAX
      const inputs = camp.querySelectorAll('.txt_unit input[type="text"]');
      let any = false;
      inputs.forEach(inp => {
        const max = parseInt(inp.getAttribute('maxlength') || '0', 10);
        const v = parseInt(inp.value || '0', 10);
        if (max > 0 && v < max) { inp.value = String(max); inp.dispatchEvent(new Event('input', { bubbles: true })); any = true; }
      });
      if (!any) continue;
      setTimeout(() => {
        const atkBtn = camp.querySelector('.btn_attack');
        if (atkBtn && !atkBtn.classList.contains('disabled') && !atkBtn.disabled) {
          atkBtn.dataset.grepbotClicked = String(Date.now());
          atkBtn.click();
          gbLog('bandit: attack sent (DOM, per-unit)');
          flash('bandit: attack sent');
          logBandit('attack');
        }
      }, 250);
      return;
    }
  }
  function scheduleBanditScan() {
    if (banditTimer) return;
    banditTimer = setTimeout(() => { banditTimer = null; banditScan(); }, 600);
  }
  function logBandit(ev) {
    state.banditLog.push({ ts: Date.now(), ev });
    if (state.banditLog.length > 50) state.banditLog = state.banditLog.slice(-50);
    save(STORE.BANDIT_LOG, state.banditLog);
  }
  setInterval(banditScan, 1500);
  setInterval(autoCollectResources, 5000); // polling fallback; observer gives sub-second response
  if (state.collectAll) collectAllBackground();

  // ---------- thresholds + alerts ----------
  function checkThresholds() {
    let changed = false;
    for (const f of state.farmsParsed) {
      const r = state.farmResources[f.vill_id];
      const t = state.thresholds[f.vill_id];
      if (!r || !r.ok || !t) continue;
      const fields = ['wood','stone','iron','pop'];
      const hits = fields.filter(k => t[k] != null && r[k] != null && r[k] >= t[k]);
      const key = hits.sort().join(',') || 'none';
      const prev = state.alerted[f.vill_id];
      if (!prev || prev.key !== key) {
        if (hits.length) flash(`⚠ farm ${f.vill_id} ${hits.join('+')} ≥ threshold`);
        state.alerted[f.vill_id] = { key, ts: Date.now() };
        changed = true;
      }
    }
    if (changed) { save(STORE.ALERTED, state.alerted); renderFarms(); }
  }

  // ---------- attack builder ----------
  function buildAttackPayload(targetId, srcTownId, units, mission) {
    return {
      action: 'attack',
      h: state.csrf,
      target_id: targetId,
      source_town: srcTownId,
      mission: mission || 'attack',
      units: units,
      note: 'prepared by GrepBot — verify in game before send',
    };
  }
  function prepareAttack(target) {
    if (!state.towns.length) { flash('no owned towns loaded yet'); return; }
    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:100001;display:flex;align-items:center;justify-content:center';
    const box = document.createElement('div');
    box.style.cssText = 'background:#1f1f1f;color:#eee;border:1px solid #555;padding:14px;border-radius:6px;width:320px;font:12px monospace';
    overlay.appendChild(box);

    const title = document.createElement('div');
    title.style.cssText = 'font-weight:bold;color:#f5a623;margin-bottom:8px';
    title.textContent = `Attack on ${target.vill_id}`;
    box.appendChild(title);

    const coord = document.createElement('div');
    coord.style.cssText = 'color:#888;margin-bottom:6px';
    coord.textContent = `coord: ${target.x ?? '?'}|${target.y ?? '?'}`;
    box.appendChild(coord);

    const srcLabel = document.createElement('label'); srcLabel.textContent = 'Source town:';
    const srcSel = document.createElement('select');
    srcSel.style.cssText = 'width:100%;background:#111;color:#cfc;border:1px solid #333;padding:3px;margin-bottom:8px';
    state.towns.forEach(t => {
      const o = document.createElement('option'); o.value = t.id; o.textContent = `${t.name || t.id} (${t.id})`;
      srcSel.appendChild(o);
    });
    box.appendChild(srcLabel); box.appendChild(srcSel);

    const missionSel = document.createElement('select');
    missionSel.style.cssText = 'width:100%;background:#111;color:#cfc;border:1px solid #333;padding:3px;margin-bottom:8px';
    ['attack','raid','siege','scout'].forEach(m => {
      const o = document.createElement('option'); o.value = m; o.textContent = m;
      missionSel.appendChild(o);
    });
    const missionLbl = document.createElement('label'); missionLbl.textContent = 'Mission:';
    box.appendChild(missionLbl); box.appendChild(missionSel);

    const unitsArea = document.createElement('textarea');
    unitsArea.style.cssText = 'width:100%;height:60px;background:#111;color:#cfc;border:1px solid #333;margin-bottom:8px;font:11px monospace';
    unitsArea.placeholder = 'sword:50\nslinger:20\narcher:10';
    const unitsLbl = document.createElement('label'); unitsLbl.textContent = 'Units (name:count per line):';
    box.appendChild(unitsLbl); box.appendChild(unitsArea);

    const btnRow = document.createElement('div');
    btnRow.style.cssText = 'display:flex;gap:6px;justify-content:flex-end;margin-top:6px';
    const cancelBtn = document.createElement('button'); cancelBtn.textContent = 'Cancel';
    cancelBtn.addEventListener('click', () => overlay.remove());
    const copyBtn = document.createElement('button');
    copyBtn.textContent = 'Copy payload'; copyBtn.style.cssText = 'background:#f5a623;color:#000';
    copyBtn.addEventListener('click', () => {
      const units = {};
      unitsArea.value.split('\n').forEach(l => {
        const m = l.trim().match(/^(\w+)\s*:\s*(\d+)/); if (m) units[m[1]] = +m[2];
      });
      const payload = buildAttackPayload(target.vill_id, srcSel.value, units, missionSel.value);
      const txt = JSON.stringify(payload, null, 2);
      navigator.clipboard.writeText(txt).then(() => { flash('payload copied'); }).catch(() => prompt('Copy:', txt));
      console.info('[grepbot] attack payload', payload);
      overlay.remove();
    });
    btnRow.appendChild(cancelBtn); btnRow.appendChild(copyBtn);
    box.appendChild(btnRow);
    document.body.appendChild(overlay);
  }
  function editThreshold(target) {
    const cur = state.thresholds[target.vill_id] || {};
    const def = Object.entries(cur).map(([k,v]) => `${k}:${v}`).join(',');
    const v = prompt(`Threshold for ${target.vill_id}\nFormat: wood:5000,iron:8000,pop:100\nEmpty = clear`, def);
    if (v == null) return;
    if (v.trim() === '') { delete state.thresholds[target.vill_id]; }
    else {
      const o = {};
      v.split(',').forEach(p => { const m = p.trim().match(/^(\w+)\s*:\s*(\d+)/); if (m) o[m[1]] = +m[2]; });
      state.thresholds[target.vill_id] = o;
    }
    save(STORE.THRESH, state.thresholds);
    state.dirty = true; scheduleFlush(); renderFarms();
  }

  function renderFarms() {
    const list = panel.querySelector('.farms-list');
    if (!list) return;
    list.replaceChildren();
    if (!state.farmsParsed.length) {
      const e = document.createElement('div');
      e.style.cssText = 'color:#888;padding:6px 0;font-size:11px';
      e.textContent = 'no farms parsed yet — add vill_id lines below';
      list.appendChild(e);
      return;
    }
    const table = document.createElement('table');
    const thead = document.createElement('thead');
    const trh = document.createElement('tr');
    ['id', 'name', 'W', 'S', 'I', 'pop', 'seen', ''].forEach(h => {
      const th = document.createElement('th');
      th.textContent = h;
      trh.appendChild(th);
    });
    thead.appendChild(trh); table.appendChild(thead);

    const tbody = document.createElement('tbody');
    for (const f of state.farmsParsed) {
      const tr = document.createElement('tr');
      const r = state.farmResources[f.vill_id];
      const t = state.thresholds[f.vill_id] || {};
      if (r && r.ok) {
        const over = (k) => t[k] != null && r[k] != null && r[k] >= t[k];
        if (over('wood') || over('stone') || over('iron') || over('pop')) tr.className = 'alert';
      }
      const cells = [
        { cls: 'id', text: f.vill_id },
        { cls: '', text: r?.name || (f.notes || '').slice(0, 20) || '—' },
        { cls: '', text: r?.ok ? fmt(r.wood) : '—' },
        { cls: '', text: r?.ok ? fmt(r.stone) : '—' },
        { cls: '', text: r?.ok ? fmt(r.iron) : '—' },
        { cls: '', text: r?.ok && r.pop != null ? `${fmt(r.pop)}/${fmt(r.cap)}` : '—' },
        { cls: r ? (r.ok ? 'stale' : 'err') : 'stale',
          text: r ? (r.ok ? `${Math.round((Date.now()-r.ts)/1000)}s` : (r.err || 'err')) : '—' },
      ];
      cells.forEach(c => {
        const td = document.createElement('td');
        if (c.cls) td.className = c.cls;
        td.textContent = c.text;
        tr.appendChild(td);
      });
      const actions = document.createElement('td');
      const atkBtn = document.createElement('button');
      atkBtn.textContent = '⚔'; atkBtn.title = 'Prepare attack';
      atkBtn.style.cssText = 'background:none;border:1px solid #555;color:#f96;padding:1px 5px;cursor:pointer;font-size:11px';
      atkBtn.addEventListener('click', () => prepareAttack(f));
      const thrBtn = document.createElement('button');
      thrBtn.textContent = '⚑'; thrBtn.title = 'Set threshold';
      thrBtn.style.cssText = 'background:none;border:1px solid #555;color:#fc6;padding:1px 5px;cursor:pointer;font-size:11px;margin-left:2px';
      thrBtn.addEventListener('click', () => editThreshold(f));
      actions.appendChild(atkBtn); actions.appendChild(thrBtn);
      tr.appendChild(actions);
      tbody.appendChild(tr);
    }
    table.appendChild(tbody);
    list.appendChild(table);
  }
  function renderWorld() {
    const totals = panel.querySelector('.world-totals');
    const list = panel.querySelector('.world-list');
    if (!totals || !list) return;
    totals.replaceChildren();
    list.replaceChildren();
    let w = 0, s = 0, i = 0, p = 0, okN = 0;
    for (const r of Object.values(state.townResources)) {
      if (!r || !r.ok) continue;
      okN++;
      if (r.wood != null) w += r.wood;
      if (r.stone != null) s += r.stone;
      if (r.iron != null) i += r.iron;
      if (r.pop != null) p += r.pop;
    }
    const totalsH = document.createElement('div');
    totalsH.style.cssText = 'font-weight:bold;color:#f5a623';
    totalsH.textContent = `${state.towns.length} towns · ${okN} ok`;
    totals.appendChild(totalsH);
    const totalsR = document.createElement('div');
    totalsR.style.cssText = 'color:#cfc;margin-top:3px';
    totalsR.textContent = `Wood ${fmt(w)} · Stone ${fmt(s)} · Iron ${fmt(i)} · Pop ${fmt(p)}`;
    totals.appendChild(totalsR);
    if (!state.towns.length) {
      const e = document.createElement('div');
      e.style.cssText = 'color:#888;padding:6px 0;font-size:11px';
      e.textContent = 'no towns loaded yet — click Refresh towns';
      list.appendChild(e);
      return;
    }
    const table = document.createElement('table');
    const trh = document.createElement('tr');
    ['id','name','W','S','I','pop','seen'].forEach(h => {
      const th = document.createElement('th');
      th.textContent = h;
      trh.appendChild(th);
    });
    table.appendChild(trh);
    for (const t of state.towns) {
      const r = state.townResources[t.id];
      const tr = document.createElement('tr');
      const cells = [
        { cls: 'id', text: t.id },
        { cls: '', text: t.name || '—' },
        { cls: '', text: r?.ok ? fmt(r.wood) : '—' },
        { cls: '', text: r?.ok ? fmt(r.stone) : '—' },
        { cls: '', text: r?.ok ? fmt(r.iron) : '—' },
        { cls: '', text: r?.ok && r.pop != null ? `${fmt(r.pop)}/${fmt(r.cap)}` : '—' },
        { cls: r ? (r.ok ? 'stale' : 'err') : 'stale',
          text: r ? (r.ok ? `${Math.round((Date.now()-r.ts)/1000)}s` : (r.err || 'err')) : '—' },
      ];
      cells.forEach(c => {
        const td = document.createElement('td');
        if (c.cls) td.className = c.cls;
        td.textContent = c.text;
        tr.appendChild(td);
      });
      table.appendChild(tr);
    }
    list.appendChild(table);
  }
  function fmt(n) {
    if (n == null) return '—';
    if (n >= 1000000) return (n/1000000).toFixed(1) + 'M';
    if (n >= 1000) return Math.round(n/1000) + 'k';
    return String(n);
  }

  // ---------- UI ----------
  GM_addStyle(`
    #grepbot-panel{position:fixed;top:8px;right:8px;width:340px;max-height:70vh;z-index:2147483647;
      background:#1f1f1f;color:#eee;font:12px/1.4 monospace;border:1px solid #555;border-radius:6px;
      box-shadow:0 4px 16px rgba(0,0,0,.5);display:flex;flex-direction:column;visibility:visible !important;opacity:1 !important;}
    #grepbot-panel header{padding:6px 10px;background:#2a2a2a;cursor:move;display:flex;justify-content:space-between;align-items:center}
    #grepbot-panel header b{color:#f5a623;font-weight:600}
    #grepbot-panel header button{background:none;border:1px solid #555;color:#eee;padding:2px 6px;border-radius:3px;cursor:pointer;font-size:11px}
    #grepbot-panel .gb-tabs{display:flex;border-bottom:1px solid #444}
    #grepbot-panel .gb-tabs button{flex:1;padding:6px;background:#262626;border:0;color:#aaa;cursor:pointer}
    #grepbot-panel .gb-tabs button.on{background:#1f1f1f;color:#fff}
    #grepbot-panel section{padding:8px 10px;overflow:auto;flex:1;min-height:200px}
    #grepbot-panel footer{padding:6px 10px;border-top:1px solid #444;display:flex;gap:6px;flex-wrap:wrap}
    #grepbot-panel footer button{background:#333;border:1px solid #555;color:#eee;padding:4px 8px;border-radius:3px;cursor:pointer;font-size:11px}
    #grepbot-panel textarea{width:100%;height:100%;min-height:180px;background:#111;color:#cfc;border:1px solid #333;font:11px/1.4 monospace;resize:vertical}
    #grepbot-panel .farms-list{margin-bottom:6px;max-height:200px;overflow:auto}
    #grepbot-panel .farms-list table{width:100%;border-collapse:collapse;font-size:10px}
    #grepbot-panel .farms-list th,#grepbot-panel .farms-list td{padding:2px 4px;border-bottom:1px solid #2a2a2a;text-align:right}
    #grepbot-panel .farms-list th{background:#262626;color:#aaa;text-align:left;font-weight:normal;position:sticky;top:0}
    #grepbot-panel .farms-list td.id{text-align:left;color:#6cf;font-family:monospace}
    #grepbot-panel .farms-list td.stale{color:#888}
    #grepbot-panel .farms-list td.err{color:#f55}
    #grepbot-panel .farms-list tr.alert td{background:rgba(255,80,80,.18);color:#faa}
    #grepbot-panel .farms-list tr.alert td.id{color:#f55;font-weight:bold}
    #grepbot-panel .world-list table{width:100%;border-collapse:collapse;font-size:10px}
    #grepbot-panel .world-list th,#grepbot-panel .world-list td{padding:2px 4px;border-bottom:1px solid #2a2a2a;text-align:right}
    #grepbot-panel .world-list th{background:#262626;color:#aaa;text-align:left;font-weight:normal;position:sticky;top:0}
    #grepbot-panel .world-list td.id{text-align:left;color:#6cf;font-family:monospace}
    #grepbot-panel .finding{padding:6px;border-bottom:1px solid #2a2a2a;font-size:11px}
    #grepbot-panel .finding .meta{color:#888;margin-bottom:3px}
    #grepbot-panel .finding .units{color:#6cf}
    #grepbot-panel .finding .res{color:#f96}
    #grepbot-panel .log-list{height:100%;min-height:180px;max-height:280px;overflow:auto;font-size:10px;white-space:pre-wrap;word-break:break-word;color:#9d9;background:#111;padding:4px;border:1px solid #333}
    #grepbot-panel.collapsed section,#grepbot-panel.collapsed footer{display:none}
  `);

  panel = document.createElement('div');
  panel.id = 'grepbot-panel';
  panel.style.zIndex = '2147483647';
  panel.innerHTML = `
    <header><b>GrepBot v${runningVersion()}</b><span id="gb-sync-badge" style="font-size:10px;color:#888;margin-left:8px"></span><button data-act="toggle">_</button></header>
    <div class="gb-tabs">
      <button data-tab="findings" class="on">Findings</button>
      <button data-tab="farms">Farms</button>
      <button data-tab="world">World</button>
      <button data-tab="log">Log</button>
    </div>
    <section data-tab="findings"></section>
    <section data-tab="farms" hidden>
      <div class="farms-list"></div>
      <textarea placeholder="vill_id | x y | ETA | notes&#10;12345 | 500 600 | 2h | safe"></textarea>
    </section>
    <section data-tab="world" hidden>
      <div class="world-totals" style="padding:6px;background:#262626;border-radius:3px;margin-bottom:6px;font-size:11px"></div>
      <div class="world-list"></div>
    </section>
    <section data-tab="log" hidden>
      <div class="log-list"></div>
    </section>
    <footer>
      <button data-act="copy">Copy JSON</button>
      <button data-act="export">Export</button>
      <button data-act="sync">Sync now</button>
      <button data-act="refresh">Refresh towns</button>
      <button data-act="scrape-farms">Farms now</button>
      <button data-act="scrape-towns">Towns now</button>
      <button data-act="diag">Diag</button>
      <button data-act="clear">Clear</button>
      <label style="font-size:11px;color:#f96;display:inline-flex;align-items:center;gap:4px;margin-left:4px;cursor:pointer" title="Click every ready Recoger (ignore timer cap) + fire collect for all towns in background. Persists across reloads.">
        <input type="checkbox" data-act="collect-all"${state.collectAll ? ' checked' : ''}/>
        Recolect all
      </label>
      <label style="font-size:11px;color:#c6f;display:inline-flex;align-items:center;gap:4px;margin-left:4px;cursor:pointer" title="Auto-attack bandit camp via the game bridge (no window needed): claims rewards, attacks when cooldown ends. Persists across reloads.">
        <input type="checkbox" data-act="auto-bandit"${state.autoBandit ? ' checked' : ''}/>
        Auto-bandit
      </label>
      <label style="font-size:11px;color:#6c6;display:inline-flex;align-items:center;gap:4px;margin-left:4px;cursor:pointer" title="Auto-claim farming villages via the game bridge every 60s: collects loot + restarts 5min gather. Villages auto-discovered, no list needed. Persists across reloads.">
        <input type="checkbox" data-act="auto-farm"${state.autoFarm ? ' checked' : ''}/>
        Auto-farm
      </label>
      <span id="gb-next-farms" style="font-size:10px;color:#6cf;margin-left:6px"></span>
      <span id="gb-next-towns" style="font-size:10px;color:#fc6;margin-left:6px"></span>
      <span id="gb-collect-state" style="font-size:10px;color:#f96;margin-left:6px;font-weight:bold"></span>
      <button data-act="reset-pos" title="Reset panel position" style="background:none;border:1px solid #555;color:#6cf;padding:2px 6px;cursor:pointer;font-size:11px">⌖</button>
      <span id="gb-status" style="font-size:10px;color:#888;margin-left:auto"></span>
    </footer>
  `;
  document.body.appendChild(panel);

  // tabs
  panel.querySelectorAll('.gb-tabs button').forEach(btn => {
    btn.addEventListener('click', () => {
      panel.querySelectorAll('.gb-tabs button').forEach(b => b.classList.remove('on'));
      btn.classList.add('on');
      const t = btn.dataset.tab;
      panel.querySelectorAll('section').forEach(s => s.hidden = s.dataset.tab !== t);
      if (t === 'world') renderWorld();
      if (t === 'log') renderLog();
    });
  });
  panel.querySelector('footer button[data-act=refresh]').addEventListener('click', () => {
    fetchOwnedTowns();
    state.towns.forEach((t, i) => setTimeout(() => fetchTownResources(t), i * 600));
  });
  panel.querySelector('header button[data-act=toggle]').addEventListener('click', () => {
    panel.classList.toggle('collapsed');
    const btn = panel.querySelector('header button[data-act=toggle]');
    btn.textContent = panel.classList.contains('collapsed') ? '▢' : '_';
  });
  panel.querySelector('footer button[data-act=copy]').addEventListener('click', () => {
    const dump = { findings: state.findings, farms: state.farms };
    navigator.clipboard.writeText(JSON.stringify(dump, null, 2))
      .then(() => flash('copied'))
      .catch(() => prompt('Copy:', JSON.stringify(dump, null, 2)));
  });
  panel.querySelector('footer button[data-act=export]').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify({ findings: state.findings, farms: state.farms }, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `grepbot-${new Date().toISOString().slice(0,10)}.json`;
    a.click();
  });
  panel.querySelector('footer button[data-act=clear]').addEventListener('click', () => {
    if (!confirm('Clear all findings?')) return;
    state.findings = []; state.seen = {}; seenThisRun.clear();
    save(STORE.FINDINGS, state.findings); save(STORE.SEEN, state.seen);
    state.dirty = true; updateSyncBadge(); scheduleFlush(500);
    renderFindings();
  });
  panel.querySelector('footer button[data-act=sync]').addEventListener('click', () => {
    flash('syncing…'); flushNow();
  });
  panel.querySelector('footer button[data-act=diag]').addEventListener('click', () => {
    diagRun();
  });
  panel.querySelector('footer button[data-act=scrape-farms]').addEventListener('click', () => {
    flash('farm scrape…');
    gbLog('manual: Farms now pressed');
    state.nextFarmScrape = 0;
    save(STORE.NEXT_FARM, 0);
    autoClaimFarms('manual');
    farmTick();
  });
  panel.querySelector('footer button[data-act=scrape-towns]').addEventListener('click', () => {
    flash('towns scrape…');
    state.nextTownsScrape = 0;
    save(STORE.NEXT_TOWNS, 0);
    farmTick();
  });
  panel.querySelector('footer input[data-act=collect-all]').addEventListener('change', (e) => {
    state.collectAll = e.target.checked;
    save(STORE.COLLECT_ALL, state.collectAll);
    flash(state.collectAll ? 'collect-all ON (bg + click all)' : 'collect-all OFF');
    if (state.collectAll) collectAllBackground();
  });
  panel.querySelector('footer button[data-act=reset-pos]').addEventListener('click', () => {
    panel.style.left = ''; panel.style.top = '8px'; panel.style.right = '8px';
    flash('panel reset');
  });
  panel.querySelector('footer input[data-act=auto-bandit]').addEventListener('change', (e) => {
    state.autoBandit = e.target.checked;
    save(STORE.AUTO_BANDIT, state.autoBandit);
    gbLog('auto-bandit', state.autoBandit ? 'ON' : 'OFF');
    flash(state.autoBandit ? 'auto-bandit ON' : 'auto-bandit OFF');
    if (state.autoBandit) banditScan();
  });
  panel.querySelector('footer input[data-act=auto-farm]').addEventListener('change', (e) => {
    state.autoFarm = e.target.checked;
    save(STORE.AUTO_FARM, state.autoFarm);
    gbLog('auto-farm', state.autoFarm ? 'ON' : 'OFF');
    flash(state.autoFarm ? 'auto-farm ON' : 'auto-farm OFF');
    if (state.autoFarm) autoClaimFarms('toggle');
  });

  // farms textarea persistence (debounced: parse+save+render once typing settles)
  const ta = panel.querySelector('textarea');
  ta.value = state.farms;
  let farmsInputTimer = null;
  ta.addEventListener('input', () => {
    state.farms = ta.value;
    clearTimeout(farmsInputTimer);
    farmsInputTimer = setTimeout(() => {
      save(STORE.FARMS, state.farms);
      refreshFarmsParsed();
      state.dirty = true; updateSyncBadge(); scheduleFlush();
      renderFarms();
    }, 400);
  });

  // drag
  (function drag(el, handle) {
    let sx, sy, dx, dy, dragging = false;
    handle.addEventListener('mousedown', e => {
      dragging = true; sx = e.clientX; sy = e.clientY; dx = el.offsetLeft; dy = el.offsetTop;
      e.preventDefault();
    });
    document.addEventListener('mousemove', e => {
      if (!dragging) return;
      el.style.left = (e.clientX - sx + dx) + 'px';
      el.style.top  = (e.clientY - sy + dy) + 'px';
      el.style.right = 'auto';
    });
    document.addEventListener('mouseup', () => { dragging = false; });
  })(panel, panel.querySelector('header'));

  function renderFindings() {
    const sec = panel.querySelector('section[data-tab=findings]');
    if (!sec) return;
    sec.replaceChildren();
    const slice = state.findings.slice(0, 80);
    if (!slice.length) {
      const empty = document.createElement('div');
      empty.style.cssText = 'color:#888;padding:10px';
      empty.textContent = 'no findings yet — visit inbox';
      sec.appendChild(empty);
      return;
    }
    for (const f of slice) {
      const row = document.createElement('div');
      row.className = 'finding';

      const meta = document.createElement('div');
      meta.className = 'meta';
      const when = new Date(f.ts).toLocaleTimeString();
      const target = f.town?.name || `t#${f.town?.id || '?'}`;
      const coord = (f.town?.x != null) ? ` (${f.town.x}|${f.town.y})` : '';
      meta.textContent = `#${f.id} · ${when} · ${f.type} · ${target}${coord}`;
      row.appendChild(meta);

      const units = document.createElement('div');
      units.className = 'units';
      units.textContent = f.units
        ? Object.entries(f.units).map(([k,v]) => `${k}:${v}`).join(' ')
        : '-';
      row.appendChild(units);

      if (f.resources && (f.resources.wood != null || f.resources.stone != null || f.resources.iron != null)) {
        const res = document.createElement('div');
        res.className = 'res';
        res.textContent = `W${f.resources.wood ?? '?'} S${f.resources.stone ?? '?'} I${f.resources.iron ?? '?'}`;
        row.appendChild(res);
      }

      sec.appendChild(row);
    }
  }
  function flash(msg) {
    const f = document.createElement('div');
    f.textContent = msg; f.style.cssText = 'position:fixed;top:60px;right:8px;background:#f5a623;color:#000;padding:6px 10px;border-radius:4px;z-index:100000';
    document.body.appendChild(f); setTimeout(() => f.remove(), 1500);
  }

  // ---------- sync to local server ----------
  let flushTimer = null;
  function scheduleFlush(delay = 2500) {
    if (flushTimer) return;
    flushTimer = setTimeout(() => { flushTimer = null; flushNow(); }, delay);
  }
  function flushNow() {
    if (!state.dirty && state.lastSync) return;
    const payload = {
      ts: Date.now(),
      world: location.host,
      player: (unsafeWindow.Game && unsafeWindow.Game.player && unsafeWindow.Game.player.name) || null,
      findings: state.findings,
      farms: state.farms,
      farmsParsed: state.farmsParsed,
      farmResources: state.farmResources,
      seen: state.seen,
      towns: state.towns,
      townResources: state.townResources,
      thresholds: state.thresholds,
    };
    GM_xmlhttpRequest({
      method: 'POST',
      url: SYNC.ENDPOINT,
      headers: { 'Content-Type': 'application/json' },
      data: JSON.stringify(payload),
      onload(r) {
        try {
          const j = JSON.parse(r.responseText);
          if (j.ok) {
            state.dirty = false;
            state.lastSync = Date.now();
            state.lastSyncErr = null;
            save('grepbot:lastSync', state.lastSync);
            gbLog('synced →', j.path);
          } else {
            state.lastSyncErr = j.err || 'unknown';
            gbLog('sync rejected by server:', state.lastSyncErr);
          }
        } catch (e) {
          state.lastSyncErr = String(e);
          console.warn('[grepbot] sync parse', e);
        }
        updateSyncBadge();
      },
      onerror(e) {
        state.lastSyncErr = 'network: server down?';
        gbLogT('sync-net', 60000, 'sync FAIL: server unreachable (server.py running?)');
        updateSyncBadge();
      },
    });
  }
  function updateSyncBadge() {
    const el = panel.querySelector('#gb-sync-badge');
    if (!el) return;
    const since = state.lastSync ? Math.round((Date.now() - state.lastSync) / 1000) : null;
    const txt = state.dirty
      ? '● pending'
      : (since === null ? '○ idle' : `✓ ${since < 60 ? since + 's' : Math.floor(since/60) + 'm'} ago`);
    el.textContent = txt;
    el.style.color = state.dirty ? '#f96' : (state.lastSyncErr ? '#f55' : '#6c6');
    if (state.lastSyncErr) el.title = 'err: ' + state.lastSyncErr;
    else el.title = 'POST ' + SYNC.ENDPOINT;
    updateStatus();
  }
  function updateStatus() {
    const el = panel.querySelector('#gb-status');
    if (!el) return;
    const csrfShort = state.csrf ? state.csrf.slice(0,6)+'…' : 'NONE';
    const farms = state.farmsParsed.length;
    const okFarms = Object.values(state.farmResources).filter(r => r && r.ok).length;
    const lastErr = Object.values(state.farmResources).filter(r => r && !r.ok).slice(-1)[0];
    const errTxt = lastErr ? ` err:${(lastErr.err || '').slice(0,20)}` : '';
    el.textContent = `csrf:${csrfShort} farms:${okFarms}/${farms}${errTxt}`;
    el.title = JSON.stringify({ csrf: state.csrf, lastSync: state.lastSync, lastSyncErr: state.lastSyncErr });
  }
  function fmtSec(s) {
    if (s < 60) return s + 's';
    const m = Math.floor(s / 60), r = s % 60;
    return r ? `${m}m${r}s` : `${m}m`;
  }
  function renderTimers() {
    const fe = panel.querySelector('#gb-next-farms');
    const te = panel.querySelector('#gb-next-towns');
    if (fe) {
      fe.textContent = state.nextFarmScrape
        ? `⏱ farms: ${fmtSec(Math.max(0, Math.round((state.nextFarmScrape - Date.now()) / 1000)))}`
        : '⏱ farms: —';
    }
    if (te) {
      te.textContent = state.nextTownsScrape
        ? `⏱ towns: ${fmtSec(Math.max(0, Math.round((state.nextTownsScrape - Date.now()) / 1000)))}`
        : '⏱ towns: —';
    }
  }
  function diagRun() {
    refreshFarmsParsed();
    console.group('[grepbot] diag');
    const bridge = gameBridgeStatus();
    console.log('game bridge', bridge);
    gbLog('diag: game bridge ' + JSON.stringify(bridge));
    console.log('csrf', state.csrf);
    console.log('farms parsed', state.farmsParsed);
    console.log('farm resources', state.farmResources);
    console.log('host', location.host, 'cookie', document.cookie);
    gbLog(`diag: csrf=${state.csrf ? 'yes' : 'NO'} farms=${state.farmsParsed.length} towns=${state.towns.length} farmAction=${state.farmAction || 'none'}`);
    const sample = (farmsFromGame() || []).slice(0, 5);
    console.log('farm relations sample', sample);
    gbLog('diag: farm sample ' + JSON.stringify(sample.slice(0, 3)));
    const first = state.farmsParsed[0];
    if (!first) { console.warn('no farms to test'); console.groupEnd(); gbLog('diag: no farms to test'); flash('no farms'); return; }
    console.log('test fetch vill_id=' + first.vill_id);
    fetchFarmResources(first);
    console.groupEnd();
    flash('diag ran — check console / Log tab');
  }

  // ---------- boot ----------
  state.csrf = huntCsrf();
  hookFetch();
  hookXhr();
  renderFindings();
  renderWorld();

  GM_registerMenuCommand('GrepBot: copy findings', () => {
    navigator.clipboard.writeText(JSON.stringify(state.findings, null, 2));
  });
  GM_registerMenuCommand('GrepBot: sync now', () => { flushNow(); });
  GM_registerMenuCommand('GrepBot: diag', () => { diagRun(); });
  GM_registerMenuCommand('GrepBot: rescan inbox', () => {
    seenThisRun.clear(); Object.keys(state.seen).forEach(k => delete state.seen[k]);
    save(STORE.SEEN, state.seen); scrapeInboxDom();
  });
  GM_registerMenuCommand('GrepBot: open data dir', () => {
    window.open('http://127.0.0.1:35657/data/', '_blank');
  });

  // periodic inbox re-scan (fallback when ajax hook misses)
  setInterval(scrapeInboxDom, 30000);
  // periodic auto-flush to local server
  setInterval(() => { if (state.dirty) flushNow(); }, SYNC.INTERVAL_MS);

  // initial badge + flush any leftovers from last run
  updateSyncBadge();
  if (state.findings.length && !state.lastSync) state.dirty = true;  // first sync of stored findings
  refreshFarmsParsed();
  renderFarms();
  renderTimers();
  if (state.dirty) scheduleFlush(1000);
  // first farm scrape 20s after boot, towns 30s; after that the persisted
  // deadlines drive cadence (survive reloads, immune to timer throttling)
  if (!state.nextFarmScrape) { state.nextFarmScrape = Date.now() + 20000; save(STORE.NEXT_FARM, state.nextFarmScrape); }
  if (!state.nextTownsScrape) { state.nextTownsScrape = Date.now() + 30000; save(STORE.NEXT_TOWNS, state.nextTownsScrape); }
  setInterval(farmTick, 15000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) farmTick(); });
  setInterval(checkThresholds, 30000);
  setInterval(renderTimers, 1000);
  // farm village claims via game bridge: first try 45s after boot, then every 60s
  setInterval(() => autoClaimFarms(), 60000);
  setTimeout(() => autoClaimFarms('boot'), 45000);

  // ---------- self-update ----------
  // TM's @updateURL check is too slow (default ~24h). Bypass: fetch the
  // userscript ourselves every 60s; if @version > running, reload page.
  const SELF = { URL: 'http://127.0.0.1:35657/grepbot.user.js', INTERVAL: 60000 };
  function runningVersion() {
    try { return (GM_info && GM_info.script && GM_info.script.version) || '0.0.0'; }
    catch (_) { return '0.0.0'; }
  }
  function cmpVer(a, b) {
    const pa = a.split(/[.\-]/).map(s => /^\d+$/.test(s) ? +s : 0);
    const pb = b.split(/[.\-]/).map(s => /^\d+$/.test(s) ? +s : 0);
    for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
      const da = pa[i] || 0, db = pb[i] || 0;
      if (da !== db) return da < db ? -1 : 1;
    }
    return 0;
  }
  function selfUpdateCheck() {
    GM_xmlhttpRequest({
      method: 'GET',
      url: SELF.URL + '?_=' + Date.now(),
      anonymous: false,
      onload(res) {
        const m = (res.responseText || '').match(/@version\s+(\S+)/);
        if (!m) return;
        const remote = m[1].trim();
        const local = runningVersion();
        if (cmpVer(remote, local) > 0) {
          // Reloading alone does NOT install the new version — Tampermonkey
          // must pull it via @updateURL (its own schedule, or the install page).
          // Reload at most once per 10min to pick up a TM-side update without
          // trapping the tab in a reload loop.
          const last = load('grepbot:upd-reload', 0);
          gbLogT('upd', 60000, `update ${local}→${remote} on server — waiting for Tampermonkey to pull it (open ${SELF.URL} once to force)`);
          if (Date.now() - last > 600000) {
            save('grepbot:upd-reload', Date.now());
            flash(`updating ${local}→${remote}`);
            setTimeout(() => location.reload(), 800);
          }
        }
      },
      onerror() { /* server down, try next tick */ },
    });
  }
  setTimeout(selfUpdateCheck, 5000);
  setInterval(selfUpdateCheck, SELF.INTERVAL);
  console.info('[grepbot] self-update checker armed, running v' + runningVersion());

  gbLog('active v' + runningVersion() + '. csrf=' + (state.csrf ? 'yes' : 'no') + ' findings=' + state.findings.length + ' bridge=' + JSON.stringify(gameBridgeStatus()));
})();